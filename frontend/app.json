{
  "expo": {
    "name": "TrueBorrow",
    "slug": "trueborrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trueborrow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splendid.trueborrow",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture documents for your loan application",
        "NSPhotoLibraryUsageDescription": "Upload documents from your gallery"
      }
    },
    "android": {
      "package": "com.splendid.trueborrow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A3B2A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A3B2A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
